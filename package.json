{
  "name": "examguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Offline-first smart glasses inspection companion for exam proctors.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "test:e2e": "playwright test",
    "setup:models": "node scripts/setup-models.mjs",
    "build:references": "node scripts/build-references.mjs",
    "format": "prettier --write src scripts tests playwright.config.ts vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
